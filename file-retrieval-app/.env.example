# File Ingestion & Retrieval App - Environment Configuration

# Database
DATABASE_URL=sqlite:///./data/database.db

# Data Directory
DATA_DIR=./data

# Upload Configuration
UPLOAD_DIR=./data/uploads
FILE_MAX_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_EXTENSIONS=pdf,docx,doc,txt,md,csv,xlsx,xls,pptx,ppt,json,xml,html

# Vector Database
VECTOR_DB=chroma  # Options: chroma, qdrant, milvus, pgvector, etc.
CHROMA_DATA_PATH=./data/chroma

# Embeddings Configuration
RAG_EMBEDDING_ENGINE=  # Leave empty for local, or use: openai, ollama, azure
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2  # Local model name
RAG_EMBEDDING_BATCH_SIZE=1

# OpenAI Embeddings (if using RAG_EMBEDDING_ENGINE=openai)
# RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=your-api-key-here

# Ollama Embeddings (if using RAG_EMBEDDING_ENGINE=ollama)
# RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_OLLAMA_API_KEY=

# Text Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=100

# Retrieval Configuration
ENABLE_RAG_HYBRID_SEARCH=false  # Enable BM25 + Vector hybrid search
RAG_RERANKING_MODEL=  # Leave empty for no reranking, or specify model

# Content Extraction
CONTENT_EXTRACTION_ENGINE=  # Leave empty for local, or use: tika, docling, external

# Storage Provider
STORAGE_PROVIDER=local  # Options: local, s3, gcs, azure

# S3 Storage (if using STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_REGION_NAME=us-east-1

# GCS Storage (if using STORAGE_PROVIDER=gcs)
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Azure Storage (if using STORAGE_PROVIDER=azure)
# AZURE_STORAGE_ENDPOINT=
# AZURE_STORAGE_CONTAINER_NAME=
# AZURE_STORAGE_KEY=

# Authentication (simplified - adjust based on your needs)
WEBUI_AUTH=false
WEBUI_SECRET_KEY=change-this-to-a-secure-random-key

# Logging
LOG_LEVEL=INFO
