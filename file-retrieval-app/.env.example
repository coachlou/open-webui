QDRANT_URI=https://67254b70-1f06-42b7-8610-8461ad42c11f.us-east-1-1.aws.cloud.qdrant.io:6333

# Storage Provider
STORAGE_PROVIDER=local  # Options: local, s3, gcs, azure

# S3 Storage (if using STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_REGION_NAME=us-east-1

# GCS Storage (if using STORAGE_PROVIDER=gcs)
