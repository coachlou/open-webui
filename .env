# Open WebUI Production Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=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

# ============================================
# Ollama Configuration (Optional)
# ============================================
# Only needed if you're using local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://ollama:11434

# ============================================
# Application Configuration
# ============================================
OPEN_WEBUI_PORT=3000
WEBUI_DOCKER_TAG=latest
BUILD_HASH=prod-build

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Generate a secure random secret key for production
# You can generate one using: openssl rand -hex 32
WEBUI_SECRET_KEY=a7f3e9b2c8d4a1f6e5b9c3d7a2f8e4b1c9d5a3f7e2b8c4d6a1f9e3b7c5d2a8f4

# Enable/disable authentication (set to false to disable login)
WEBUI_AUTH=true

# ============================================
# Network & CORS Configuration
# ============================================
# For production, set this to your domain(s)
# CORS_ALLOW_ORIGIN=https://yourdomain.com
CORS_ALLOW_ORIGIN=*

# For production behind a proxy (Coolify/nginx/traefik)
FORWARDED_ALLOW_IPS=*

# ============================================
# Branding (Optional)
# ============================================
WEBUI_NAME=Jansen Legal Assist

# ============================================
# Database Configuration (Optional)
# ============================================
# By default, SQLite is used. Uncomment below for PostgreSQL
# DATABASE_URL=postgresql://openwebui:changeme@postgres:5432/openwebui
# POSTGRES_DB=openwebui
# POSTGRES_USER=openwebui
# POSTGRES_PASSWORD=changeme

