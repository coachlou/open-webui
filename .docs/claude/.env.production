# Open WebUI Production Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Ollama Configuration (Optional)
# ============================================
# Only needed if you're using local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://ollama:11434

# ============================================
# Application Configuration
# ============================================
OPEN_WEBUI_PORT=3000
WEBUI_DOCKER_TAG=latest
BUILD_HASH=prod-build

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Generate a secure random secret key for production
# You can generate one using: openssl rand -hex 32
WEBUI_SECRET_KEY=your-secret-key-here

# Enable/disable authentication (set to false to disable login)
WEBUI_AUTH=true

# ============================================
# Network & CORS Configuration
# ============================================
# For production, set this to your domain(s)
# CORS_ALLOW_ORIGIN=https://yourdomain.com
CORS_ALLOW_ORIGIN=*

# For production behind a proxy (Coolify/nginx/traefik)
FORWARDED_ALLOW_IPS=*

# ============================================
# Branding (Optional)
# ============================================
WEBUI_NAME=Open WebUI

# ============================================
# Database Configuration (Optional)
# ============================================
# By default, SQLite is used. Uncomment below for PostgreSQL
# DATABASE_URL=postgresql://openwebui:changeme@postgres:5432/openwebui
# POSTGRES_DB=openwebui
# POSTGRES_USER=openwebui
# POSTGRES_PASSWORD=changeme

# ============================================
# Additional API Keys (Optional)
# ============================================
# Anthropic Claude
# ANTHROPIC_API_KEY=

# Google AI
# GOOGLE_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ============================================
# Advanced Configuration (Optional)
# ============================================
# Enable debug mode (not recommended for production)
# DEBUG=false

# Custom upload size limits (in MB)
# FILE_UPLOAD_SIZE_LIMIT=100

# Session timeout (in seconds)
# SESSION_TIMEOUT=3600
